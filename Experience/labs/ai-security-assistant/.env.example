# Copy to .env and fill in your values.
# The .env file is gitignored — never commit secrets.

# --- LLM providers ---
# openai    -> hosted, requires OPENAI_API_KEY
# anthropic -> hosted, requires ANTHROPIC_API_KEY
# local     -> any OpenAI-compatible server on this machine (LM Studio, Ollama, vLLM)
# mock      -> deterministic offline provider, no credentials (tests and demos)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- Local LLM (LM Studio / Ollama / vLLM) ---
# Start LM Studio's local server, then set:
# LLM_PROVIDER=local
# LLM_MODEL=qwen2.5-coder-7b-instruct   # name exactly as shown in LM Studio
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio

# --- Zero-config offline run (no model server needed) ---
# LLM_PROVIDER=mock

# --- Database (pgvector) ---
# DATABASE_URL=postgresql+psycopg://ai_security:ai_security_dev@localhost:5432/ai_security

# --- Jira integration ---
# JIRA_URL=https://your-jira.example.com
# JIRA_TOKEN=...

# --- MCP server ---
# MCP_AUTH_TOKEN=...

# --- Agent limits ---
AGENT_MAX_TURNS=10

